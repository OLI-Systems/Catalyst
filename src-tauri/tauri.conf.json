{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catalyst",
  "version": "1.1.1",
  "identifier": "com.olisystems.catalyst",
  "build": {
    "beforeBuildCommand": "node build/stage-sidecar.js",
    "frontendDist": "splash-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Catalyst",
        "url": "index.html",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "visible": true,
        "backgroundColor": "#06080d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/OLI-Systems/Catalyst/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDN0EzNDhDODIxN0RFRDUKUldUVjNoZUNqRFI2WEE5YVNDVllRV3ZpYWpQUDNNdFhzTUJZRGFLOHprMDFyY3RtcE5QaTJWOXkK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "public.app-category.developer-tools",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/catalyst-server"],
    "resources": ["sidecar/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null
    }
  }
}
